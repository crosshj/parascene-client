# Copy to .env.local for `vercel dev` — never commit real keys.
# Same PARASCENE_CLIENT_ID must appear in index.html as window.PSN_CLIENT_ID (static HTML cannot read env).

PARASCENE_API_KEY=psn_your_secret_key_here
PARASCENE_CLIENT_ID=your_public_oauth_client_id
# Optional:
# PARASCENE_BASE_URL=https://www.parascene.com
